<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width= , initial-scale=1.0">
    <link rel="stylesheet" href="/Static/css/style.css">
    <link rel="icon" type="image/x-icon" href="/Static/images/image1.png">
    <title>Majestic Hotel Home Page</title>
</head>

<body>
    <header>
        <div class="container">
            <div class="nav">
                <a href="/">
                    <img src="/Static/images/image1.png" alt="Logo" class="logo">
                </a>
                <nav>
                    <ul class="nav-links">
                        <h1>Majestic Hotel</h1>
                        <li><a href="/">Home</a></li>
                        <li><a href="/Room">Rooms</a></li>
                        <li><a href="/Contact">Contact</a></li>
                    </ul>
                </nav>
            </div>

            <div class="number">
                <img src="/Static/images/image7.png" alt="Phone Icon" class="icon">
                <p>+383 (044) 847 024</p>
                <a href="/Contact">
                    <button>Book Now</button>
                </a>
            </div>
        </div>
    </header>

    <main>
        <div class="contact">
            <div class="num1">
                <p>GET IN TOUCH</p>
                <h1>Contact Us</h1>
                <p>We are here to assist you with reservations, special requests, or any questions
                    you<br>may have.
                    Our team is available around the clock to ensure your experience
                    is<br>nothing short of exceptional.
                </p>
                <br><br>
                <div class="num2">
                    <img src="/Static/images/image19.png" alt="icon" class="icon5">
                    <div class="num3">
                        <h3>Address</h3>
                        <p>123 Main Street, City, Country<br>New York, NY 10001</p>
                    </div>
                </div>
                <div class="num2">
                    <img src="/Static/images/image7.png" alt="icon" class="icon5">
                    <div class="num3">
                        <h3>Phone</h3>
                        <p>Reservation: +383 (045) 847-024 <br>
                            Front Desk: +383 (045) 847-024
                        </p>
                    </div>
                </div>
                <div class="num2">

                    <img src="/Static/images/image20.png" alt="icon" class="icon5">
                    <div class="num3">
                        <h3>Email</h3>
                        <p>altinbalaj773@gmail.com<br>
                            info@majestichotel.com
                        </p>
                    </div>
                </div>
                <div class="num2">
                    <img src="/Static/images/image18.png" alt="icon" class="icon5">
                    <div class="num3">
                        <h3>Hours</h3>
                        <p>Front Desk: 24/7<br>
                            Restaurant: 8:00 AM - 11:00 PM
                        </p>
                    </div>
                </div>
            </div>

            <form action="" id="contact-form">

                <div class="send">
                    <div class="things">
                        <h1>Send us a Message</h1>
                        <div class="input">
                            <div class="input1">
                                <label for="Name">Name</label>
                                <input id="name" type="text" placeholder="Your Name"><br><br>
                            </div>
                            <div class="input1">
                                <label for="Email">Email</label>
                                <input type="email" id="email" placeholder="Your Email">
                            </div>
                        </div>

                        <div class="subject">
                            <label for="subject">Subject</label><br>
                            <select id="subject" name="subject">
                                <option value="">Select a subject</option>
                                <option value="room">Room Reservation</option>
                                <option value="restaurant">Restaurant Reservation</option>
                                <option value="events">Events & Meetings</option>
                                <option value="feedback">Feedback</option>
                                <option value="other">Other Inquiry</option>
                            </select>
                        </div>

                        <div class="message">
                            <label for="message">Message</label><br>
                            <textarea id="message" name="message" placeholder="How can we help you?"></textarea>
                        </div>

                        <button id="sendBtn" type="submit" href="/Home">
                            Send Message
                        </button><br><br><br>
                    </div>
                </div>
            </form>
        </div>
    </main>
<br><br><br>
    <footer class="footer">

        <div class="footer-container">

            <!-- Left -->
            <div class="footer-box">
                <h2>Majestic Hotel</h2>

                <p>
                    Experience unparalleled luxury and
                    exceptional service in the heart of the city.
                </p>
            </div>

            <!-- Quick links -->
            <div class="footer-box">
                <h4>QUICK LINKS</h4>

                <ul>
                    <li><a href="#">Rooms & Suites</a></li>
                    <li><a href="#">Dining</a></li>
                    <li><a href="#">Spa & Wellness</a></li>
                    <li><a href="#">Events</a></li>
                    <li><a href="#">Offers</a></li>
                </ul>
            </div>

            <!-- Information -->
            <div class="footer-box">
                <h4>INFORMATION</h4>

                <ul>
                    <li><a href="#">About Us</a></li>
                    <li><a href="#">Careers</a></li>
                    <li><a href="#">Press</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of Service</a></li>
                </ul>
            </div>

            <!-- Newsletter -->
            <div class="footer-box">
                <h4>NEWSLETTER</h4>

                <p>Subscribe for exclusive offers and updates.</p>

                <input type="email" placeholder="Enter your email">
                <a href="/Contact">
                    <button>SUBSCRIBE</button>
                </a>

            </div>

        </div>
        <br>
        <hr>
        <br>

        <p>© 2026 Majestic Hotel. All rights reserved.</p>

    </footer>
    <script src="/app.js"></script>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>


    <script>
        emailjs.init("XKnbvyMRFzQRwUX7u");

        const sendBtn = document.getElementById("sendBtn");

        sendBtn.addEventListener("click", function (e) {

            e.preventDefault();

            const templateParams = {
                from_name: document.getElementById("name").value,
                from_email: document.getElementById("email").value,
                subject: document.getElementById("subject").value,
                message: document.getElementById("message").value
            };

            console.log(templateParams);

            emailjs.send(
                "service_a6cvj9f",
                "template_r2fnl4r",
                templateParams
            )
                .then(function (response) {

                    console.log("SUCCESS!", response);

                    alert("Message sent successfully!");

                })
                .catch(function (error) {

                    console.log("FAILED...", error);

                    alert("Failed to send message!");

                });

        });
    </script>
</body>

</html>